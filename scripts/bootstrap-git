#!/usr/bin/env bash
set -euo pipefail

config_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
work_host=leadforensics.ghe.com
work_config=${XDG_CONFIG_HOME:-$HOME/.config}/git/mise-work.gitconfig

# Older Git accepts unknown config keys but silently ignores autoSetupRemote.
if ! version=$(git version) || [[ ! $version =~ ([0-9]+)\.([0-9]+) ]] ||
   (( BASH_REMATCH[1] < 2 || (BASH_REMATCH[1] == 2 && BASH_REMATCH[2] < 37) )); then
  printf 'Git bootstrap requires Git 2.37 or newer; install or upgrade Git first.\n' >&2
  exit 1
fi

for key in GIT_{PERSONAL,WORK}_{NAME,EMAIL}; do
  value=${!key:-}
  if [[ ! $value =~ [^[:space:]] || $value == *$'\n'* || $value == *$'\r'* ]] ||
     [[ $key == *_EMAIL && ! $value =~ ^[^[:space:]@]+@[^[:space:]@]+$ ]]; then
    printf 'Set a valid value for %s in fnox.\n' "$key" >&2
    exit 1
  fi
done

# Git runs ! helpers through /bin/sh; quote paths for that shell.
quote() {
  printf "'%s'" "${1//\'/\'\\\'\'}"
}
mise_bin=${MISE_BIN:-$(command -v mise)}
helper="!$(quote "$mise_bin") -C $(quote "$config_dir") exec -- bash $(quote "$config_dir/scripts/git-credential-fnox")"

mkdir -p "$(dirname -- "$work_config")"
git config --file "$work_config" --replace-all user.name "$GIT_WORK_NAME"
git config --file "$work_config" --replace-all user.email "$GIT_WORK_EMAIL"
git config --file "$work_config" --replace-all mise.githubHost "$work_host"

git config --global --replace-all init.defaultBranch main
git config --global --replace-all push.default simple
git config --global --replace-all push.autoSetupRemote true
git config --global --replace-all user.useConfigOnly true
git config --global --replace-all user.name "$GIT_PERSONAL_NAME"
git config --global --replace-all user.email "$GIT_PERSONAL_EMAIL"

# Add a missing value or collapse exact duplicates without removing other values.
ensure_global_value() {
  git config --global --fixed-value --replace-all "$1" "$2" "$2"
}

# The identity condition sees the stored URL, before insteadOf rewriting.
for remote in "https://$work_host/**" "https://*@$work_host/**" "ssh://git@$work_host/**" "git@$work_host:*/**"; do
  ensure_global_value "includeIf.hasconfig:remote.*.url:$remote.path" "$work_config"
done

for host in github.com "$work_host"; do
  ensure_global_value "url.https://$host/.insteadOf" "git@$host:"
  ensure_global_value "url.https://$host/.insteadOf" "ssh://git@$host/"

  key="credential.https://$host.helper"
  # An empty helper clears earlier helpers for this host, including any unscoped ones.
  git config --global --replace-all "$key" ''
  git config --global --add "$key" "$helper $host"
done
