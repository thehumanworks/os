#!/usr/bin/env bash
set -euo pipefail

case ${1:-} in
  github.com|leadforensics.ghe.com) ;;
  *) exit 0 ;;
esac

# fnox owns the credentials; Git should neither store nor erase them.
[[ ${2:-} == get ]] || exit 0
protocol= host=
while IFS= read -r line && [[ -n $line ]]; do
  case $line in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
  esac
done
[[ $protocol == https && $host == "$1" ]] || exit 0

config_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
token=$(fnox --config "$config_dir/dotfiles/fnox/config.toml" --profile "$host" --if-missing error get GH_TOKEN)
[[ $token =~ ^[[:graph:]]+$ ]] || exit 1
printf 'username=x-access-token\npassword=%s\n\n' "$token"
